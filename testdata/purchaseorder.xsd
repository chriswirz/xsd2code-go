<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/po"
           targetNamespace="http://example.com/po"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>
      A purchase order. Exercises the constructs a generator has to get right:
      inheritance by extension, a choice, an enumeration, an attribute group,
      a named group, repeated content, an xs:list and simple content.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="purchaseOrder" type="tns:PurchaseOrderType">
    <xs:annotation>
      <xs:documentation>The document root of a purchase order.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:complexType name="PurchaseOrderType">
    <xs:sequence>
      <xs:element name="shipTo" type="tns:USAddress"/>
      <xs:element name="billTo" type="tns:USAddress" minOccurs="0"/>
      <xs:element name="comment" type="xs:string" minOccurs="0"/>
      <xs:element name="items" type="tns:Items"/>
      <xs:choice>
        <xs:element name="creditCard" type="tns:PaymentType"/>
        <xs:element name="invoice" type="tns:PaymentType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="orderDate" type="xs:date" use="required"/>
    <xs:attribute name="status" type="tns:OrderStatus" default="pending"/>
    <xs:attributeGroup ref="tns:auditAttributes"/>
  </xs:complexType>

  <xs:attributeGroup name="auditAttributes">
    <xs:annotation>
      <xs:documentation>Who last touched the document, and when.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="modifiedBy" type="xs:string"/>
    <xs:attribute name="modifiedAt" type="xs:dateTime"/>
  </xs:attributeGroup>

  <xs:complexType name="AddressBase" abstract="true">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="street" type="xs:string" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="USAddress">
    <xs:complexContent>
      <xs:extension base="tns:AddressBase">
        <xs:sequence>
          <xs:element name="city" type="xs:string"/>
          <xs:element name="state" type="xs:string"/>
          <xs:element name="zip" type="xs:decimal"/>
        </xs:sequence>
        <xs:attribute name="country" type="xs:NMTOKEN" fixed="US"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:group name="itemDetail">
    <xs:sequence>
      <xs:element name="productName" type="xs:string"/>
      <xs:element name="quantity" type="xs:positiveInteger"/>
      <xs:element name="price" type="tns:Money"/>
    </xs:sequence>
  </xs:group>

  <xs:complexType name="Items">
    <xs:sequence>
      <xs:element name="item" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="tns:itemDetail"/>
            <xs:element name="shipDate" type="xs:date" minOccurs="0" nillable="true"/>
            <xs:element name="tags" type="tns:TagList" minOccurs="0"/>
          </xs:sequence>
          <xs:attribute name="partNum" type="tns:SKU" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Money">
    <xs:annotation>
      <xs:documentation>An amount with the currency it is denominated in.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="PaymentType">
    <xs:sequence>
      <xs:element name="reference" type="xs:string"/>
      <xs:element name="amount" type="tns:Money"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="OrderStatus">
    <xs:annotation>
      <xs:documentation>Where the order has got to.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="pending"/>
      <xs:enumeration value="shipped"/>
      <xs:enumeration value="cancelled"/>
      <xs:enumeration value="on-hold"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SKU">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{3}-[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TagList">
    <xs:annotation>
      <xs:documentation>Free-form tags, space separated.</xs:documentation>
    </xs:annotation>
    <xs:list itemType="xs:string"/>
  </xs:simpleType>
</xs:schema>
